# Copy to .env and adjust. Every value here is a throwaway local default.
# Host ports bind to 127.0.0.1 only.

POSTGRES_USER=shopflow
POSTGRES_PASSWORD=shopflow-dev
POSTGRES_DB=shopflow
POSTGRES_PORT=5437

RABBITMQ_USER=shopflow
RABBITMQ_PASSWORD=shopflow-dev
RABBITMQ_PORT=5674
RABBITMQ_UI_PORT=15674

REDIS_PORT=6382

ORDER_SERVICE_PORT=3010
NOTIFICATION_GATEWAY_PORT=3011

# Signs the JWT that clients present in the Socket.IO handshake.
JWT_SECRET=dev-only-change-me
