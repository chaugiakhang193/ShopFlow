{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "types": [
      "vitest/globals",
      "node"
    ],
    "paths": {
      "@shopflow/boundary": [
        "./libs/boundary/src/index.ts"
      ]
    }
  },
  "files": [],
  "references": [
    {
      "path": "./apps/order-service/tsconfig.app.json"
    },
    {
      "path": "./apps/order-service/tsconfig.spec.json"
    },
    {
      "path": "./libs/boundary/tsconfig.spec.json"
    }
  ]
}
